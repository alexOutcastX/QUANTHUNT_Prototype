# systemd unit for the QuantHunt gunicorn service.
# setup-vm.sh installs this to /etc/systemd/system/quanthunt.service and
# substitutes __DEPLOY_USER__ with the deploy user (opc / ubuntu).
#
# Binds 127.0.0.1 only — the app is never exposed directly; nginx (port 80/443)
# is the sole public entry point and reverse-proxies to it.
[Unit]
Description=QuantHunt screener (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=/opt/quanthunt
Environment=PORT=5000
# Boot-time fundamentals sweep over the NSE universe (~2700 symbols), starting
# ~45 s after boot, so the valuation and growth filters have data before anyone
# opens a screen. Sources are the exchanges' own endpoints (see exchange_fund).
#
# Budget: ~8 s per symbol at FUND_WARM_WORKERS=4 → about 90 minutes for a cold
# cache. Only the FIRST sweep costs that. Entries live 7 days and fund_cache.json
# is excluded from the deploy rsync, so later boots skip everything still fresh
# and finish in seconds. Progress is in the developer portal, which can also stop
# a sweep or start a scoped one.
Environment=FUND_WARM=ALL
# Keep the technical-scan cache hot so the screener paints from cache instead
# of computing per visit. NIFTY 500 contains the 50 and the 100, so this is
# ~500 distinct symbols; at the 15-minute row TTL that settles to well under
# one upstream history call per second once the first pass completes.
Environment=SCAN_WARM=NIFTY 500,NIFTY 50,NIFTY 100
# Optional secrets/config (e.g. EODHD_API_KEY=...) — the leading '-' means the
# service still starts if the file is absent. Deploys never overwrite it.
EnvironmentFile=-/opt/quanthunt/.env
# One worker, many threads: the universe/price caches are per-process in memory,
# so multiple workers would each re-fetch from NSE and defeat the 6-hour cache.
# Threads (not workers) absorb the burst of parallel calls a single dossier /
# analyser open fires (strategy + timeframes + checklist + fundamentals + …),
# each of which can block for seconds on yfinance/NSE. 8 threads saturated and
# hung the whole site; 32 gives ample headroom for several concurrent users.
# --graceful-timeout recycles a worker that a stuck request wedges.
ExecStart=/opt/quanthunt/venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 1 --threads 32 --timeout 120 --graceful-timeout 30 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
